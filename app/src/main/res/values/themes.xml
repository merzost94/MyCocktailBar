<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyCocktailBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/cocktail_purple</item>
        <item name="colorPrimaryVariant">@color/cocktail_dark_purple</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand colors -->
        <item name="colorSecondary">@color/cocktail_gold</item>
        <item name="colorSecondaryVariant">@color/cocktail_dark_gold</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Background colors - ТЕМНАЯ ТЕМА -->
        <item name="android:colorBackground">#121212</item>
        <item name="colorSurface">#1E1E1E</item>
        <item name="colorOnSurface">#E0E0E0</item>
        <item name="colorOnBackground">#E0E0E0</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/cocktail_dark_purple</item>

        <!-- Text colors для темной темы -->
        <item name="android:textColor">#E0E0E0</item>
        <item name="android:textColorPrimary">#E0E0E0</item>
        <item name="android:textColorSecondary">#9E9E9E</item>
    </style>

    <style name="Theme.MyCocktailBar" parent="Base.Theme.MyCocktailBar" />
</resources>