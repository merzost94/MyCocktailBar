<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="cocktail"
            type="com.example.mycocktailbar.models.Cocktail" />

        <variable
            name="ingredients"
            type="java.util.List&lt;com.example.mycocktailbar.models.Ingredient&gt;" />

        <import type="android.view.View" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_dark">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_dark">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="@{cocktail.name}"
                app:titleTextColor="@color/text_primary_dark"
                app:navigationIcon="?attr/homeAsUpIndicator"
                app:navigationIconTint="@color/primary" />

        </com.google.android.material.appbar.AppBarLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ИСПРАВЛЕНО: ImageView с правильными параметрами -->
                <ImageView
                    android:id="@+id/cocktailImage"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_cocktail_placeholder"
                    android:background="@color/gray_700"
                    android:visibility="@{cocktail.imageUrl != null &amp;&amp; !cocktail.imageUrl.isEmpty() ? View.VISIBLE : View.GONE}"/>

                <TextView
                    android:id="@+id/categoryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@{cocktail.category}"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/category_badge"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:visibility="@{cocktail.category != null &amp;&amp; !cocktail.category.isEmpty() ? View.VISIBLE : View.GONE}" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginVertical="8dp"
                    android:background="@drawable/status_badge"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/descriptionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@{cocktail.description}"
                    android:textSize="16sp"
                    android:textColor="@color/text_secondary_dark"
                    android:lineSpacingExtra="4dp"
                    android:visibility="@{cocktail.description != null &amp;&amp; !cocktail.description.isEmpty() ? View.VISIBLE : View.GONE}" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="@color/gray_600" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ингредиенты:"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_dark"
                    android:layout_marginBottom="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/ingredientsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="@{ingredients != null &amp;&amp; !ingredients.isEmpty() ? View.VISIBLE : View.GONE}" />

                <TextView
                    android:id="@+id/emptyIngredientsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Нет ингредиентов"
                    android:textSize="14sp"
                    android:textColor="@color/text_hint_dark"
                    android:gravity="center"
                    android:padding="16dp"
                    android:visibility="@{ingredients == null || ingredients.isEmpty() ? View.VISIBLE : View.GONE}" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="@color/gray_600" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Инструкция приготовления:"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_dark"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/instructionsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{cocktail.instructions}"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary_dark"
                    android:lineSpacingExtra="4dp"
                    android:visibility="@{cocktail.instructions != null &amp;&amp; !cocktail.instructions.isEmpty() ? View.VISIBLE : View.GONE}" />

            </LinearLayout>
        </ScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>