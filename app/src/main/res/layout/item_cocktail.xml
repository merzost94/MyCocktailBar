<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="cocktail"
            type="com.example.mycocktailbar.models.Cocktail" />

        <import type="android.view.View" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/card_dark"
        app:strokeColor="@color/gray_600"
        app:strokeWidth="1dp"
        android:foreground="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@{cocktail.name}"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary_dark"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{cocktail.category}"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:background="@drawable/category_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_marginBottom="8dp"
                android:visibility="@{cocktail.category != null ? View.VISIBLE : View.GONE}"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@{cocktail.description}"
                android:textSize="14sp"
                android:textColor="@color/text_secondary_dark"
                android:maxLines="2"
                android:ellipsize="end"/>

            <!-- Список ингредиентов -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ингредиенты будут здесь"
                android:textSize="12sp"
                android:textColor="@color/text_secondary_dark"
                android:layout_marginTop="8dp"
                android:visibility="gone"/> <!-- Временно скрыто, пока не добавим логику -->

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>