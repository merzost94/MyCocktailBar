<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="ingredient"
            type="com.example.mycocktailbar.models.Ingredient" />

        <import type="android.view.View" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/transparent"
        app:strokeColor="@color/gray_600"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:background="@color/card_dark">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@{ingredient.name}"
                android:textSize="16sp"
                android:textColor="@color/text_primary_dark"/>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_check_circle"
                android:tint="@{ingredient.hasItem ? @color/status_available : @color/gray_500}"
                android:visibility="@{ingredient.hasItem ? View.VISIBLE : View.GONE}"/>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_cancel"
                android:tint="@color/gray_500"
                android:visibility="@{ingredient.hasItem ? View.GONE : View.VISIBLE}"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>